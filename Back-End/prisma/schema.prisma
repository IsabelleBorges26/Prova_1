generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id      Int      @id @default(autoincrement())
  nome    String
  email   String
  tarefas Tarefa[]
}

model Tarefa {
  id           Int        @id @default(autoincrement())
  usuarioId    Int
  descricao    String
  setor        String
  prioridade   Prioridade
  dataCadastro DateTime   @default(now())
  status       Status     @default(A_FAZER)
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

enum Status {
  A_FAZER
  FAZENDO
  PRONTO
}

